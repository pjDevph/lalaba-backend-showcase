# Copy this file to .env and fill in the secret values.
# Ask a teammate (or check the team password manager) for FIREBASE_WEB_API_KEY,
# RESEND_API_KEY, and firebase-adminsdk.json — none of those are committed to git.

# Database switch — see README.md "Local MongoDB Setup" section.
# on  = hosted Atlas MongoDB (MONGODB_URI_ONLINE)
# off = local Docker MongoDB (MONGODB_URI_LOCAL) — start it with: docker compose up -d
MONGODB_ONLINE=off
MONGODB_URI_LOCAL=mongodb://localhost:27017/lalabaDev?replicaSet=rs0
MONGODB_URI_ONLINE=

# Firebase Admin SDK service account key file path
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json
FIREBASE_STORAGE_BUCKET=lalaba-kwyky-ecosystem.firebasestorage.app
# Firebase Web API key (from Firebase Console > Project Settings > General)
FIREBASE_WEB_API_KEY=

# Firebase Auth Emulator — fully offline login for local mode.
# Set by ../scripts/set-mode.sh. When non-empty, firebase-admin routes Auth
# calls to the local emulator (../scripts/emulator.sh) instead of the real project.
FIREBASE_AUTH_EMULATOR_HOST=

# Firebase Storage Emulator — local media/KYC storage. Also set by
# ../scripts/set-mode.sh, always in lockstep with the auth host above so a local
# backend can never write into the real production bucket.
#
# When non-empty, uploads go to the emulator (files persist in
# ../.firebase-emulator-data/) and read URLs are UNSIGNED — the emulator cannot
# verify signed URLs, so private KYC evidence is not access-controlled locally.
# Leave empty for online mode, where reads go through short-lived signed URLs.
#
# Use the machine's LAN IP (e.g. 192.168.1.5:9199), NOT localhost. This value is
# baked verbatim into every stored photo/logo URL, and `localhost` is resolved
# by the CLIENT: it works from the iOS simulator, but on Android it means the
# emulator's own loopback (the host is 10.0.2.2) and on a real device it means
# the phone. A washer's photo showing in the customer app but not her own is
# this bug. After changing the host, repoint the existing rows:
#   npx ts-node scripts/migrations/rewrite-storage-host.ts --from <old-host> --apply
FIREBASE_STORAGE_EMULATOR_HOST=

PORT=3001
RESEND_API_KEY=

# CORS allowlist for browser clients (comma-separated, no spaces). The mobile
# app isn't affected — React Native fetch doesn't enforce CORS — but any
# browser-based client (e.g. LALABA_ADMIN-PANEL) needs its origin listed here
# or every cross-origin request gets blocked before it reaches a resolver.
ALLOWED_ORIGINS=http://localhost:3000

# Xendit payment gateway (wallet top-ups).
#
# XENDIT_ONLINE is the local/live switch (same convention as MONGODB_ONLINE):
#   on    → real Xendit; requires XENDIT_SECRET_KEY
#   off   → dev auto-succeed gateway, even if keys are filled in below, so you
#           can keep your keys and flip back to offline testing in one edit
#   unset → real Xendit if XENDIT_SECRET_KEY is set, dev gateway otherwise
# Production always uses real Xendit: `off` there REFUSES TO BOOT, as does a
# missing key. The app also refuses to boot on a key/environment mismatch —
# a live xnd_production_ key outside production, or a test xnd_development_
# key in production.
XENDIT_ONLINE=off

# Test-mode keys look like xnd_development_...; live keys xnd_production_...
XENDIT_SECRET_KEY=
# Authenticates POST /webhooks/xendit via the x-callback-token header. While
# unset the webhook rejects every request, so top-ups can never settle.
XENDIT_CALLBACK_TOKEN=

# Overrides the Xendit API host (sandbox mocks, contract tests). Leave unset
# for the real API at https://api.xendit.co.
# XENDIT_BASE_URL=

# With XENDIT_ONLINE=on, `npm run local` opens a cloudflared quick tunnel and
# prints the webhook URL to paste into the Xendit dashboard. That URL changes
# every restart. Set this to a fixed public hostname (named tunnel, staging
# host) and the script skips cloudflared and just echoes the stable URL.
# XENDIT_WEBHOOK_BASE_URL=https://dev-webhook.lalaba.ph

# Require a second factor for admin/support sign-in. 'on' enforces; anything
# else (including unset) is off.
#
# Turning this on REJECTS EVERY BACK-OFFICE ACCOUNT THAT HAS NOT ENROLLED,
# including the one you would use to turn it back off. Enrol the team first,
# confirm each account shows a second factor, and only then switch it on.
# Requires Firebase Identity Platform (multi-factor is not available on the
# free Authentication tier).
ADMIN_MFA_REQUIRED=off

# SEC-004/B2 — shared rate-limit counters (Render Key Value; Redis/Valkey compatible).
# Leave UNSET locally: the throttler falls back to in-memory storage in dev/test.
# REQUIRED in production — the app refuses to start without it, because
# in-memory counters mean per-instance limits that reset on every deploy.
# Use the INTERNAL connection URL so traffic stays on Render's private network.
# REDIS_URL=redis://red-xxxxxxxxxxxx:6379

# APPCHK — Firebase App Check enforcement for the custom backend.
# off (default) = monitoring only: tokens are verified when present and the
#   result is logged, but a missing/invalid token never blocks a request.
# on            = @RequireAppCheck() handlers reject unattested requests.
# Do NOT switch on until every first-party client ships attestations AND the
# App Check console metrics show legitimate traffic verifying. Enabling early
# locks out real users on installs that predate the App Check build.
APP_CHECK_ENFORCED=off
